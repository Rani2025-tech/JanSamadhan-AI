# JanSamadhan AI Environment Configuration

# Gemini AI Provider
# Obtain key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Database Configuration (SQLite default; also supports PostgreSQL / MySQL)
DATABASE_URL=sqlite:///./jansamadhan.db

# Authentication Security (Change in production!)
JWT_SECRET=your_jwt_secret_token_here_2026

# Admin Credentials (env-driven)
ADMIN_EMPLOYEE_ID=OD-ADM-2024-88
ADMIN_PASSWORD=your_rotated_admin_password_here
ADMIN_EMAIL=alok.mohapatra@odisha.gov.in

# AI Confidence Threshold for Human Review
AI_CONFIDENCE_THRESHOLD=0.60

# Server Host and Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
