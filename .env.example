GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT=20

JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRE_HOURS=24
ADMIN_EMAIL=admin@jansamadhan.local
ADMIN_PASSWORD=your_admin_password_here
DEMO_OFFICIAL_PASSWORD=your_demo_password_here
FAISS_INDEX_PATH=faiss_index/
DATA_PATH=data/
DEMO_DATA_LABEL=0
DEMO_SEED_ALLOWED=1
# Demo mode for judges (one-click demo sessions with restricted permissions)
# NOTE: DEMO_MODE must be 0 on any server holding real citizen data!
DEMO_MODE=0
DEMO_OFFICIAL_DEPARTMENT="Public Health Engineering / Water Board"
DEMO_TOKEN_MINUTES=60
CHAT_RATE_PER_MIN=15
TRUST_PROXY=0

# Production only — set these on Render dashboard
# Leave DATABASE_URL unset to use local SQLite
DATABASE_URL=postgresql://user:password@host/dbname
FRONTEND_URL=https://your-frontend-service.onrender.com
API_URL=https://your-backend-service.onrender.com/api
